 void ExtensionsMenuDelegateDesktop::CloseBubble() {
-  bubble_contents_->GetWidget()->CloseWithReason(
-      views::Widget::ClosedReason::kCloseButtonClicked);
+  // `OpenMainPage()` may call this during bubble construction (e.g. when the
+  // menu has no entries), before the contents view has been placed in a
+  // Widget. Dereferencing a null Widget here crashes, so no-op when there is
+  // no Widget yet; the coordinator discards the unshown bubble instead.
+  views::Widget* const widget = bubble_contents_->GetWidget();
+  if (!widget) {
+    return;
+  }
+  widget->CloseWithReason(views::Widget::ClosedReason::kCloseButtonClicked);
 }
 
